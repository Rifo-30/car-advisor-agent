# ===== LLM（不填则自动进入 mock 模式，全流程仍可跑通）=====
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash

# ===== 第三方 / 中转网关（OpenAI 官方可留空）=====
# DeepSeek 官方: https://api.deepseek.com/v1
# 中转站示例:   https://your-proxy.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ===== PostgreSQL + pgvector（不填则自动回退到内置样本数据）=====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/car_advisor

# ===== Redis（不填则回退到进程内缓存）=====
REDIS_URL=redis://localhost:6379

# ===== Langfuse 追踪（不填则回退到本地 trace）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
