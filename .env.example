# ===== LLM（不填则自动进入 mock 模式，全流程仍可跑通）=====
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash

# ===== 第三方 / 中转网关（OpenAI 官方可留空）=====
# DeepSeek 官方: https://api.deepseek.com/v1
# 中转站示例:   https://your-proxy.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ===== PostgreSQL + pgvector（不填则自动回退到内置样本数据）=====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/car_advisor

# ===== Redis（不填则回退到进程内缓存）=====
REDIS_URL=redis://localhost:6379

# ===== Langfuse 追踪（不填则回退到本地 trace）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ===== 意图解析：规则 + 模型混合 =====
# false 时强制只用规则（不调模型）
INTENT_MODEL_ENABLED=true

# ===== RAG 口碑 query 改写 =====
# false 时只用规则构建检索 query，不调用模型
RAG_QUERY_REWRITE_ENABLED=true

# ===== 受控 Tool Calling =====
# false 时复杂多工具任务降级为确定性工具计划
TOOL_AGENT_ENABLED=true
# 单轮最多模型-工具循环次数
TOOL_AGENT_MAX_STEPS=6

# ===== Agent 评测 =====
# eval:live 时默认开启 judge；无 Key 会自动跳过
EVAL_JUDGE_ENABLED=true
# 成本估算单价（每 100 万 token，币种由部署方自定义）
EVAL_INPUT_COST_PER_1M=0
EVAL_OUTPUT_COST_PER_1M=0
# 可选：成本回归上限；不填则不设成本门槛
EVAL_MAX_COST=
# 可选：只运行指定用例，例如 rec-01,rev-03,res-01
EVAL_CASE_FILTER=
